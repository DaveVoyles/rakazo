#!/usr/bin/env python3
"""Fail-open TypeSafe (System One / Jev) classifier for mail triage.

The ONLY place this skill touches the TypeSafe SDK/API. classify() never
raises and returns a result or None -- disabled, no key, network error,
timeout, malformed response, low confidence, and a tripped in-process
breaker all resolve to None, the same shape as "TypeSafe was never called".
A caller that ignores None degrades to whatever it already does today.

Kill switch / fallback triggers (all silent, all print nothing and exit 0
with no stdout):
  - RAKAZO_TYPESAFE_ENABLED unset or falsy (default OFF)
  - RAKAZO_TYPESAFE_API_KEY unset/empty AND no `typesafe-api-key` Keychain
    item for the current user
  - any network error, non-2xx response, or malformed response body
  - the call exceeding RAKAZO_TYPESAFE_TIMEOUT_SECS (default 2.0, no retry)
  - a returned confidence below RAKAZO_TYPESAFE_MIN_CONFIDENCE (default 0.9)
  - two failures in the same process trip a lightweight breaker that skips
    the network for the rest of this process's life

Usage:
    typesafe-classify --subject S --sender A --snippet TEXT

Prints one line of JSON on a confident answer:
    {"urgency": "...", "requires_reply": "...", "nature": "..."}
Prints nothing and exits 0 on every fallback path above -- the caller's own
categorization is the only thing that can act. This never exits non-zero
except on a usage error (bad flags), which is a caller bug, not a TypeSafe
failure.

Privacy: only --subject, --sender and --snippet are ever sent, and --snippet
is truncated to SNIPPET_MAX_CHARS and stripped of quoted-reply lines before
it leaves this process. No attachments, headers, or full body are read or
sent. Nothing here writes to disk or logs the message content.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request
from dataclasses import dataclass

API_URL = "https://api.typesafe.ai/v1/systemone"
MODEL = "jev-latest"

_DEFAULT_TIMEOUT_SECS = 2.0
_DEFAULT_MIN_CONFIDENCE = 0.9
_TRIP_AFTER_FAILURES = 2
SNIPPET_MAX_CHARS = 500

QUESTIONS = {
    "urgency": {
        "type": "choice",
        "instructions": "How soon does a person need to see this email?",
        "criteria": {
            "now": "Needs attention today or sooner",
            "this_week": "Should be handled within a few days",
            "no_rush": "No real time pressure",
        },
    },
    "requires_reply": {
        "type": "choice",
        "instructions": "Does this email expect a reply from the recipient?",
        "criteria": {
            "yes": "A response is expected",
            "no": "No response is expected",
        },
    },
    "nature": {
        "type": "choice",
        "instructions": "What kind of email is this?",
        "criteria": {
            "actionable": "Asks the recipient to do something",
            "fyi": "Informational, no action needed",
            "spam_promo": "Marketing, spam, or promotional content",
            "notification": "An automated system notification",
        },
    },
}

_breaker_tripped = False
_failure_count = 0


@dataclass(frozen=True)
class TriageResult:
    urgency: str
    requires_reply: str
    nature: str


def enabled() -> bool:
    return os.environ.get("RAKAZO_TYPESAFE_ENABLED", "").strip().lower() in ("1", "true", "yes", "on")


def _timeout_secs() -> float:
    try:
        return float(os.environ.get("RAKAZO_TYPESAFE_TIMEOUT_SECS", _DEFAULT_TIMEOUT_SECS))
    except ValueError:
        return _DEFAULT_TIMEOUT_SECS


def _min_confidence() -> float:
    try:
        return float(os.environ.get("RAKAZO_TYPESAFE_MIN_CONFIDENCE", _DEFAULT_MIN_CONFIDENCE))
    except ValueError:
        return _DEFAULT_MIN_CONFIDENCE


def _api_key() -> str | None:
    """Env var wins (explicit, scriptable); Keychain is the interactive
    fallback. Either missing is a normal, silent reason to skip."""
    env_key = os.environ.get("RAKAZO_TYPESAFE_API_KEY", "").strip()
    if env_key:
        return env_key
    try:
        out = subprocess.run(
            ["security", "find-generic-password", "-w", "-s", "typesafe-api-key",
             "-a", os.environ.get("USER", "")],
            capture_output=True, text=True, timeout=1.0,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return None
    key = out.stdout.strip()
    return key or None


def _record_failure() -> None:
    global _breaker_tripped, _failure_count
    _failure_count += 1
    if _failure_count >= _TRIP_AFTER_FAILURES:
        _breaker_tripped = True


def reset_breaker_for_test() -> None:
    global _breaker_tripped, _failure_count
    _breaker_tripped = False
    _failure_count = 0


def redact_snippet(text: str) -> str:
    """Strip quoted-reply chains and cap length before anything leaves this
    process. A quoted reply is the rest of a thread, not this message --
    sending it teaches TypeSafe nothing and grows the privacy surface for
    free."""
    if not text:
        return ""
    lines = []
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith(">"):
            continue
        if re.match(r"^on .+ wrote:$", stripped, re.IGNORECASE):
            break
        lines.append(line)
    joined = "\n".join(lines).strip()
    return joined[:SNIPPET_MAX_CHARS]


def classify(subject: str, sender: str, snippet: str) -> TriageResult | None:
    """Ask TypeSafe all three triage questions in one call. Returns None on
    ANY failure path. Never raises."""
    if not enabled():
        return None
    if _breaker_tripped:
        return None
    clean_snippet = redact_snippet(snippet)
    if not subject.strip() and not clean_snippet:
        return None

    key = _api_key()
    if not key:
        return None

    payload = {
        "state": {
            "subject": subject.strip(),
            "sender_domain": sender.strip().rsplit("@", 1)[-1] if "@" in sender else sender.strip(),
            "snippet": clean_snippet,
        },
        "model": MODEL,
        "questions": QUESTIONS,
    }
    req = urllib.request.Request(
        API_URL,
        data=json.dumps(payload).encode(),
        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=_timeout_secs()) as resp:
            body = json.loads(resp.read())
    except (urllib.error.URLError, TimeoutError, OSError, ValueError, json.JSONDecodeError):
        _record_failure()
        return None

    try:
        answers = body["answers"]
        parsed = {}
        confidences = []
        for key_name in ("urgency", "requires_reply", "nature"):
            ans = answers[key_name]
            parsed[key_name] = ans["choice"]
            confidences.append(float(ans["confidence"]))
    except (KeyError, TypeError, ValueError):
        _record_failure()
        return None

    if min(confidences) < _min_confidence():
        return None
    return TriageResult(**parsed)


def main() -> int:
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--subject", default="")
    p.add_argument("--sender", default="")
    p.add_argument("--snippet", default="")
    args = p.parse_args()

    result = classify(args.subject, args.sender, args.snippet)
    if result is not None:
        print(json.dumps({
            "urgency": result.urgency,
            "requires_reply": result.requires_reply,
            "nature": result.nature,
        }))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
