#!/bin/sh
set -eu
RAKAZO_HOME="${HOME:-/home/rakazo}"
PROFILE="$RAKAZO_HOME/.browser-profiles/chromium"
mkdir -p "$PROFILE"
# Prefer the real binary. Debian's /usr/bin/chromium wrapper can force a
# gnome/libsecret password store and ignore --password-store=basic.
BIN=""
if [ -x /usr/lib/chromium/chromium ]; then
  BIN=/usr/lib/chromium/chromium
else
  BIN="$(command -v chromium || command -v chromium-browser || true)"
fi
if [ -z "$BIN" ]; then
  echo "chromium is not installed" >&2
  exit 1
fi
exec "$BIN" \
  --test-type \
  --no-sandbox \
  --disable-dev-shm-usage \
  --disable-gpu \
  --disable-software-rasterizer \
  --no-first-run \
  --no-default-browser-check \
  --disable-session-crashed-bubble \
  --hide-crash-restore-bubble \
  --password-store=basic \
  --user-data-dir="$PROFILE" \
  --start-maximized \
  "$@"
